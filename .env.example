# ==============================================================================
# LLM 설정 (OpenRouter 또는 로컬 서빙 vLLM / Ollama 등 OpenAI 호환 규격)
# ==============================================================================
# 1) OpenRouter 사용 시:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=google/gemini-3.1-flash-lite
# v2 기능(app/v2/**) 전용 모델. 비우면 코드 기본값(google/gemini-3.1-flash-lite)을 쓴다
# LLM_MODEL_V2=google/gemini-3.1-flash-lite
# 시뮬레이션 호출에 response_format=json_object 를 붙인다. 지원하지 않는 로컬 모델이면 0
# LLM_JSON_MODE=1

# 2) 로컬 서빙 (vLLM, Ollama, LM Studio 등) 사용 시 예시:
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_API_KEY=dummy
# LLM_MODEL=local-model

# 3) 태깅·추출만 RunPod vLLM(Kanana)으로 (serving/README.md). 비우면 위 메인 LLM 을 쓴다
#    SLM 이 꺼져 있거나 실패하면 메인 LLM 으로 자동 폴백한다
# SLM_BASE_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
# SLM_API_KEY=
# 태깅 SLM 이 primary 를 비우면(off_topic 아님) 그 답만 메인 LLM 으로 다시 태깅한다 (agents._slm_left_primary_empty)
# SLM_TAGGING_MODEL=tagging-v2
# SLM_EXTRACTION_MODEL=extraction-v2
# SLM_PROBE_INTERVAL_S=15

# 4) 연습대화(v2)를 애착 9칸 모델(RunPod vLLM, Kanana-2-1.3b + 칸별 LoRA)로 (app/v2/practice/cells.py)
#    비우면 연습대화는 메인 LLM(LLM_MODEL_V2)만 쓴다. 위 태깅 SLM 과 다른 서버라 따로 적는다
#    - 세션을 시작할 때 서버가 살아 있으면 9칸, 아니면 메인 LLM 으로 정해 세션에 고정한다
#    - 칸은 상대 페르소나의 회피·불안 점수로 자동 선택 (예: 회피 72·불안 55 → high_anx0.75)
#    - 서버가 꺼졌거나 첫 글자 전에 실패하면 그 턴부터 메인 LLM 으로 넘어가고 되돌리지 않는다
#    - 상태 재확인 간격은 위 SLM_PROBE_INTERVAL_S 를 같이 쓴다
#    - API 키: 9칸 서버를 띄울 때 넣은 API_KEY (persona_model 의 KANANA_API_KEY)
#    - 첫 글자 대기 시간(초): 넘기면 이 턴을 메인 LLM 으로 다시 보낸다. 기본 3
# PRACTICE_SLM_BASE_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
# PRACTICE_SLM_API_KEY=
# PRACTICE_SLM_FIRST_CHUNK_TIMEOUT_S=3

# 5) 문장 판정 카드 학습 후보 알림 (app/features/sentence_cards/notify.py)
#    BE 답변 묶음을 받을 때 AGREE · 사람 확인된 DISAGREE 가 충분히 쌓이면 이 Discord 웹훅으로 알린다
#    비우면 로그(WARNING)로만 남고, 설정하면 다음 묶음 때 밀린 알림을 보낸다
# TRAINING_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# ==============================================================================
# 데이터베이스 & 서버 설정
# ==============================================================================
INTERNAL_API_KEY=
DATABASE_URL=postgresql+asyncpg://ktb:ktb@localhost:5432/ktb
DB_ECHO=0

# ==============================================================================
# 타임아웃 및 동시성 제어 (선택 사항 - 기본값 있음)
# ==============================================================================
# SIMULATION_MAX_INFLIGHT=20
# 타임아웃·요청 한도·서버 오류 시 LLM 호출 재시도 횟수 (0 이면 끔). 타임아웃은 시도마다 적용
# LLM_RETRY_ATTEMPTS=1
# ONBOARDING_TAG_TIMEOUT_S=15.0
# PERSONA_RETAG_TIMEOUT_S=20.0
# ONBOARDING_PHRASE_TIMEOUT_S=15.0
# PERSONA_EXTRACT_TIMEOUT_S=15.0
# ONBOARDING_FIRST_TURN_TIMEOUT_S=20.0
# PRACTICE_TIMEOUT_S=15.0
# SIMULATION_SCRIPT_TIMEOUT_S=120.0

# ==============================================================================
# LANGFUSE
# ==============================================================================
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Cloud 리전에 맞는 주소 또는 self-hosted 루트 주소. /api/public 을 붙이지 않습니다.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 배포 환경과 릴리스를 분리해 대시보드에서 비교할 때 사용합니다.
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_RELEASE=local
# 연결 문제를 조사할 때만 true 로 바꿉니다.
LANGFUSE_DEBUG=false

# ==============================================================================
# SENTRY
# ==============================================================================
# 비워 두면 Sentry 로 이벤트를 보내지 않습니다.
SENTRY_DSN=
# 배포 환경과 릴리스 태그 (SDK 가 자동으로 읽습니다).
SENTRY_ENVIRONMENT=local
# SENTRY_RELEASE=

# ==============================================================================
# 프로필 신뢰 (대표사진 심사·얼굴 인증)
# ==============================================================================

# 모델 경로
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
LBF_MODEL_PATH=models/lbfmodel.yaml
SFACE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
FACE_LANDMARKER_MODEL_PATH=models/face_landmarker.task
PALM_MODEL_PATH=models/palm_detection_mediapipe_2023feb.onnx
HANDPOSE_MODEL_PATH=models/handpose_estimation_mediapipe_2023feb.onnx
SYNTHETIC_MODEL_PATH=models/community_forensics_vit_int8.onnx

# 대표 사진 검사 기준 (값은 코드 기본값과 같다)
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_EDGE_PX=160
MIN_BLUR_VARIANCE=8
MIN_BRIGHTNESS=45
MAX_BRIGHTNESS=215
MAX_ABS_YAW_DEG=20
MAX_ABS_PITCH_DEG=18
MAX_ABS_ROLL_DEG=22
# 대표사진 양쪽 눈 감김(MediaPipe eyeBlink) 점수가 모두 이 값 이상이면 탈락
MAX_EYE_BLINK_SCORE=0.45

# 합성 이미지 및 얼굴 비교 기준. 운영 데이터로 반드시 재보정하세요.
SYNTHETIC_RISK_THRESHOLD=0.70
FACE_MATCH_THRESHOLD=0.42

# 라이브 촬영 정면 허용 범위
LIVENESS_MAX_ABS_YAW_DEG=25
LIVENESS_MAX_ABS_PITCH_DEG=25
LIVENESS_MAX_ABS_ROLL_DEG=40

# 라이브니스 챌린지 서명 키. 운영에서는 충분히 긴 랜덤 값으로 교체하세요.
LIVENESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
LIVENESS_TOKEN_TTL_SECONDS=300
# 기본 true: 손 모양·방향 유지 + 고개 이동·정면 복귀. BE/FE v2를 먼저 배포해야 한다.
# 기존 환경에 false가 남아 있으면 true로 변경하고 AI 컨테이너를 재생성한다.
# false는 롤백 및 v2 미지원 BE/FE 배포 환경의 이전 정면 챌린지 발급용이다.
ACTIVE_LIVENESS_ENABLED=true
# v3 계획(protocol_version 3)은 BE가 지원한 뒤 true로 켠다. false면 고개 포함 v2 계획을 발급한다.
ADAPTIVE_LIVENESS_ENABLED=false
FACE_VERIFICATION_MAX_INFLIGHT=2
MAX_VIDEO_BYTES=12582912

# 신뢰할 C2PA 인증서 PEM. 비어 있으면 C2PA를 확정 차단 근거로 사용하지 않습니다.
C2PA_TRUST_ANCHORS_PATH=
