# ==============================================================================
# LLM 설정 (OpenRouter 또는 로컬 서빙 vLLM / Ollama 등 OpenAI 호환 규격)
# ==============================================================================
# 1) OpenRouter 사용 시:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=google/gemini-2.5-flash-lite
# 시뮬레이션 호출에 response_format=json_object 를 붙인다. 지원하지 않는 로컬 모델이면 0
# LLM_JSON_MODE=1

# 2) 로컬 서빙 (vLLM, Ollama, LM Studio 등) 사용 시 예시:
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_API_KEY=dummy
# LLM_MODEL=local-model

# ==============================================================================
# 데이터베이스 & 서버 설정
# ==============================================================================
INTERNAL_API_KEY=
DATABASE_URL=postgresql+asyncpg://ktb:ktb@localhost:5432/ktb
DB_ECHO=0

# ==============================================================================
# 타임아웃 및 동시성 제어 (선택 사항 - 기본값 있음)
# ==============================================================================
# SIMULATION_MAX_INFLIGHT=20
# ONBOARDING_TAG_TIMEOUT_S=4.0
# PERSONA_RETAG_TIMEOUT_S=8.0
# ONBOARDING_PHRASE_TIMEOUT_S=5.0
# PERSONA_EXTRACT_TIMEOUT_S=15.0
# ONBOARDING_FIRST_TURN_TIMEOUT_S=8.0
# PRACTICE_TIMEOUT_S=12.0
# SIMULATION_SCRIPT_TIMEOUT_S=120.0

# ==============================================================================
# LANGFUSE
# ==============================================================================
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Cloud 리전에 맞는 주소 또는 self-hosted 루트 주소. /api/public 을 붙이지 않습니다.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 배포 환경과 릴리스를 분리해 대시보드에서 비교할 때 사용합니다.
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_RELEASE=local
# 연결 문제를 조사할 때만 true 로 바꿉니다.
LANGFUSE_DEBUG=false

# ==============================================================================
# SENTRY
# ==============================================================================
# 비워 두면 Sentry 로 이벤트를 보내지 않습니다.
SENTRY_DSN=
# 배포 환경과 릴리스 태그 (SDK 가 자동으로 읽습니다).
SENTRY_ENVIRONMENT=local
# SENTRY_RELEASE=

# ==============================================================================
# 프로필 신뢰 (대표사진 심사·얼굴 인증)
# ==============================================================================
# /test 브라우저 테스트 페이지. 운영에서는 false
ENABLE_TEST_UI=false

# 모델 경로
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
LBF_MODEL_PATH=models/lbfmodel.yaml
SFACE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
SYNTHETIC_MODEL_PATH=models/community_forensics_vit_int8.onnx

# 대표 사진 검사 기준 (값은 코드 기본값과 같다)
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_EDGE_PX=160
MIN_BLUR_VARIANCE=8
MIN_BRIGHTNESS=45
MAX_BRIGHTNESS=215
MAX_ABS_YAW_DEG=20
MAX_ABS_PITCH_DEG=18
MAX_ABS_ROLL_DEG=22

# 합성 이미지 및 얼굴 비교 기준. 운영 데이터로 반드시 재보정하세요.
SYNTHETIC_RISK_THRESHOLD=0.70
FACE_MATCH_THRESHOLD=0.42

# 라이브 촬영 정면 허용 범위
LIVENESS_MAX_ABS_YAW_DEG=25
LIVENESS_MAX_ABS_PITCH_DEG=25
LIVENESS_MAX_ABS_ROLL_DEG=40

# 라이브니스 챌린지 서명 키. 운영에서는 충분히 긴 랜덤 값으로 교체하세요.
LIVENESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
LIVENESS_TOKEN_TTL_SECONDS=300
MAX_VIDEO_BYTES=26214400

# 신뢰할 C2PA 인증서 PEM. 비어 있으면 C2PA를 확정 차단 근거로 사용하지 않습니다.
C2PA_TRUST_ANCHORS_PATH=
