# Anthropic — 프로덕션 agents.py, 플레이그라운드 anthropic 경로
ANTHROPIC_API_KEY=

# 플레이그라운드 Gemini 경로
GEMINI_API_KEY=

# 플레이그라운드 기본 프로바이더: gemini | anthropic
LLM_PROVIDER=gemini

# Postgres — app.core.db 엔진. postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://ktb:ktb@localhost:5432/ktb
# SQL 로그 (1 이면 켬)
DB_ECHO=0
