{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ktb:quality-datasets:1.0",
  "title": "합성 품질 평가 데이터 항목",
  "type": "object",
  "required": [
    "input",
    "expectedOutput",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "enum": [
            "persona_conversation",
            "persona_tagging",
            "persona_build",
            "practice_reply",
            "simulation_run",
            "simulation_report_preview"
          ]
        }
      }
    },
    "expectedOutput": {
      "type": "object",
      "required": [
        "hardAssertions",
        "referenceLabels",
        "acceptableRanges",
        "requiredEvidence",
        "forbidden",
        "rubric"
      ],
      "properties": {
        "hardAssertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "referenceLabels": {
          "type": "object"
        },
        "acceptableRanges": {
          "type": "object"
        },
        "requiredEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "dimensions",
              "location"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "enum": [
                    "avoidance",
                    "anxiety",
                    "disclosure",
                    "openness",
                    "positivity",
                    "assurances",
                    "contact_rhythm",
                    "problem_solving",
                    "withdrawal",
                    "engagement",
                    "compliance",
                    "ideal_warmth",
                    "ideal_vitality",
                    "ideal_status",
                    "seriousness",
                    "interests",
                    "routine",
                    "date_prefer",
                    "date_avoid"
                  ]
                }
              },
              "location": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rubric": {
          "type": "object",
          "required": [
            "scale",
            "criteria",
            "anchors",
            "status"
          ],
          "properties": {
            "scale": {
              "const": [
                1,
                5
              ]
            },
            "criteria": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "anchors": {
              "type": "object"
            },
            "status": {
              "const": "pending_dual_human_review"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "caseId",
        "dataset",
        "split",
        "splitGroup",
        "category",
        "difficulty",
        "sourceRefs",
        "generationMethod",
        "prototypeId",
        "familyId",
        "piiClass",
        "rubricVersion",
        "reviewFlags"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "enum": [
            "persona_onboarding_conversation",
            "persona_onboarding_tagging",
            "persona_build",
            "practice_reply",
            "simulation_run",
            "simulation_report_preview"
          ]
        },
        "split": {
          "enum": [
            "calibration",
            "regression",
            "blind_holdout"
          ]
        },
        "splitGroup": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "generationMethod": {
          "const": "astra-xhigh-v1"
        },
        "prototypeId": {
          "type": "string",
          "minLength": 1
        },
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "piiClass": {
          "const": "synthetic"
        },
        "rubricVersion": {
          "const": "1.0"
        },
        "reviewFlags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evaluationKind": {
          "enum": [
            "language_quality",
            "code_behavior",
            "label_accuracy"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "dataset": {
                "const": "persona_onboarding_conversation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "task",
              "history",
              "topic",
              "turnIndex",
              "totalTurns",
              "nickname"
            ],
            "properties": {
              "task": {
                "const": "persona_conversation"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "dataset": {
                "const": "persona_onboarding_tagging"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "task",
              "question",
              "answer"
            ],
            "properties": {
              "task": {
                "const": "persona_tagging"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "dataset": {
                "const": "persona_build"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "task",
              "history",
              "session",
              "coverage"
            ],
            "properties": {
              "task": {
                "const": "persona_build"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "dataset": {
                "const": "practice_reply"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "task",
              "partner",
              "history",
              "opening"
            ],
            "properties": {
              "task": {
                "const": "practice_reply"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "dataset": {
                "const": "simulation_run"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "task",
              "persona_a",
              "persona_b",
              "turns"
            ],
            "properties": {
              "task": {
                "const": "simulation_run"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "dataset": {
                "const": "simulation_report_preview"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "task",
              "persona_a",
              "persona_b",
              "transcript",
              "useLlm"
            ],
            "properties": {
              "task": {
                "const": "simulation_report_preview"
              }
            }
          }
        }
      }
    }
  ]
}
