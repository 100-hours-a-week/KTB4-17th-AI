# 화자 혼동 측정과 로컬 리뷰 산출물. 제품 경로가 아니다.
scripts/measure_confusion.py
scripts/judge_confusion.py
llm_prompt_context_guide.html
evals/review/langfuse_prod_eval_2026-10-02.html

# 로컬 SQLite 파일
*.db

# IDE
.idea/
.vscode/

# docs는 모두 로컬 산출물로 두고 버전 관리하지 않는다.
docs/

# 얼굴 인증 런타임 모델은 scripts/download_models.py 로 받는다
models/*
!models/README.md
.memsearch
.claude/
trouble

# 파인튜닝 산출물 (학습 파일·어댑터·평가 결과). 어댑터는 모델 저장소(HF Hub·S3)에 버전으로 올린다
training/tagging/out/
training/tagging/adapters/
evals/results/

# 증류 데이터 (scripts/generate_synthetic_onboarding.py · label_with_teacher.py 출력). 크고 다시 만들 수 있다
data/synthetic/
data/teacher/
data/simfid/

# 골드셋 초안 작업 파일(scripts/gold_drafts.py). 확정 골드셋은 evals/quality_datasets/human/ 에 남긴다
data/gold_work/

# 기능별 LLM 성능평가. 시험과 채점 실행에 쓰는 파일만 버전 관리한다.
# 시뮬레이션 v1(f10, f11)은 2026-10-28 평가 제외.
evals/f10-simulation-v1-speak/
evals/f11-simulation-migration-report/
evals/AMBIGUOUS_CARDS.md
evals/labels_calibration.html
evals/labels_disagree.html

# 실행 결과, Judge 캐시, 작업 로그. 대본 재실행 프롬프트 캐시만 남긴다.
evals/f*/results/
evals/_harness/runs/*
!evals/_harness/runs/lf_eval_cache.json

# 2단계 샘플과 입력 초안. 심사·수정 재실행과 종료 메시지 입력만 남긴다.
evals/f*/samples.jsonl
!evals/f14-simulation-v2-judge/samples.jsonl
!evals/f15-simulation-v2-repair/samples.jsonl
evals/f*/inputs.jsonl
!evals/f17-chat-end-drafts/inputs.jsonl
!evals/f18-chat-end-message/inputs.jsonl

# 라벨 작업본. 합의 라벨만 남긴다.
evals/f*/labels/*
!evals/f*/labels/calibration_final.csv

# 시험지 생성 스크립트. 채점 실행 파일만 남긴다.
evals/_harness/*.py
!evals/_harness/common.py
!evals/_harness/auto_checks.py
!evals/_harness/stage3_types.py
!evals/_harness/stage5_checks.py
!evals/_harness/stage5_judges.py
!evals/_harness/stage5_run.py
!evals/_harness/stage5_labels.py
!evals/_harness/stage5_rejudge.py
!evals/_harness/stage5_rescore.py
!evals/_harness/run_kakao.py
!evals/_harness/run_simulation.py
