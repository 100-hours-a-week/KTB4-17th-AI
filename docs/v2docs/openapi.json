            "type": "integer"
          },
          "required_sampled_frames": {
            "default": 8,
            "title": "Required Sampled Frames",
            "type": "integer"
          },
          "required_valid_face_frames": {
            "default": 6,
            "title": "Required Valid Face Frames",
            "type": "integer"
          },
          "sampled_frames": {
            "title": "Sampled Frames",
            "type": "integer"
          },
          "sampling_strategy": {
            "default": "uniform_max_24",
