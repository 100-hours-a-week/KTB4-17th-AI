            "title": "Compared Frame Count",
            "type": "integer"
          },
          "frame_similarities": {
            "items": {
              "type": "number"
            },
            "title": "Frame Similarities",
            "type": "array"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "threshold",
          "compared_frame_count",
          "frame_similarities"
        ],
